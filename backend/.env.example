# backend/.env  — copy to backend/.env and fill in real values.
# The backend loads this file directly (dotenv), so it must be self-contained.

# ─── KASM Server (REQUIRED) ─────────────────────────────────────────────────
KASM_BASE_URL=https://192.168.64.3                # KASM VM URL (https)
KASM_API_KEY=QggTiOwNFqf8
KASM_API_SECRET=7fFA2MYD8zdkrhIRA7DUL7HbcEnPhtNE
KASM_IMAGE_ID=6960d986cbe24b6c9d3611c1c58f1372         # copy after registering image
KASM_VERIFY_SSL=false                             # false for self-signed cert

# ─── Approach 2 — KASM port mapping (REQUIRED for chat) ─────────────────────
# Backend calls the bridge directly over HTTP. In KASM Admin → Workspaces →
# Docker Run Config Override add: {"ports": {"3100/tcp": 3100}}
KASM_BRIDGE_URL=http://192.168.64.3:3100          # KASM VM IP + mapped host port

# ─── Backend ────────────────────────────────────────────────────────────────
PORT=4000
FRONTEND_URL=http://localhost:3000

# IP the KASM container uses to reach this backend for the agent-ready webhook.
# Mac + UTM: the UTM host-only IP (NOT Wi-Fi, NOT localhost).
TEAMBOTS_WEBHOOK_BASE=http://192.168.64.1:4000

# ─── Tuning (optional — defaults shown) ─────────────────────────────────────
KASM_SESSION_READY_TIMEOUT_S=180                  # wait for container to run
KASM_KEEPALIVE_INTERVAL_S=60                      # keepalive ping interval
KASM_CHAT_TIMEOUT_MS=120000                       # bridge /chat HTTP timeout
