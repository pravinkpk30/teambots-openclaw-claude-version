# backend/.env  — copy to backend/.env and fill in real values.
# The backend loads this file directly (dotenv), so it must be self-contained.

# ─── KASM Server (REQUIRED) ─────────────────────────────────────────────────
KASM_BASE_URL=https://192.168.65.4                # KASM VM URL (https)
KASM_API_KEY=QggTiOwNFqf8
KASM_API_SECRET=7fFA2MYD8zdkrhIRA7DUL7HbcEnPhtNE
KASM_IMAGE_ID=d29eccc105ae4e30b51aa78d655b076d         # copy after registering image
KASM_VERIFY_SSL=false                             # false for self-signed cert

# ─── Approach 2 — KASM port mapping (REQUIRED for chat) ─────────────────────
# Backend calls the bridge directly over HTTP. In KASM Admin → Workspaces →
# Docker Run Config Override add: {"ports": {"3100/tcp": 3100}}
KASM_BRIDGE_URL=http://192.168.65.4:3100          # KASM VM IP + mapped host port

# ─── Backend ────────────────────────────────────────────────────────────────
PORT=4000
FRONTEND_URL=http://localhost:3000
# Artifact links (Open/Download/Copy) must point at the backend, not the React app.
PUBLIC_BACKEND_URL=http://localhost:4000
# Public URL embedded in artifact links returned to the chat UI (defaults to request Host)
PUBLIC_BACKEND_URL=http://localhost:4000

# IP the KASM container uses to reach this backend for the agent-ready webhook.
# Mac + UTM: the UTM host-only IP (NOT Wi-Fi, NOT localhost).
TEAMBOTS_WEBHOOK_BASE=http://192.168.65.1:4000

# Optional: OpenClaw web search provider override (duckduckgo|gemini|parallel-free|brave|…)
# Default: gemini for Google hires, duckduckgo otherwise. See https://docs.openclaw.ai/tools/web
# TEAMBOTS_WEB_SEARCH_PROVIDER=duckduckgo

# Optional: MCP servers JSON for OpenClaw (stdio or HTTP). Passed to every hire.
# TEAMBOTS_MCP_SERVERS={"fetch":{"command":"npx","args":["-y","@modelcontextprotocol/server-fetch"]}}

# ─── Tuning (optional — defaults shown) ─────────────────────────────────────
KASM_SESSION_READY_TIMEOUT_S=180                  # wait for container to run
KASM_KEEPALIVE_INTERVAL_S=60                      # keepalive ping interval
KASM_CHAT_TIMEOUT_MS=120000                       # bridge /chat HTTP timeout
