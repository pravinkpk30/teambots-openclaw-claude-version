# ─── KASM Server ──────────────────────────────────────────────────────────────
KASM_BASE_URL=https://192.168.64.3
KASM_API_KEY=QggTiOwNFqf8
KASM_API_SECRET=7fFA2MYD8zdkrhIRA7DUL7HbcEnPhtNE
KASM_IMAGE_ID=2ab41469daf04996ab1e301466d1ba8c
# Set false for self-signed KASM certs (UTM/local VM)
KASM_VERIFY_SSL=false

# ─── Backend ──────────────────────────────────────────────────────────────────
PORT=4000
FRONTEND_URL=http://localhost:3000

# CRITICAL (Approach 2 — KASM port mapping): the bridge URL the backend calls
# directly over HTTP. KASM publishes container :3100 to the VM host via the
# workspace Docker Run Config "ports". Use the KASM VM IP + mapped host port.
#   KASM Admin → Workspaces → Docker Run Config Override:
#   {"ports": {"3100/tcp": 3100}}
KASM_BRIDGE_URL=http://192.168.64.3:3100

# CRITICAL (Mac + UTM): IP that the KASM container can reach your Mac backend.
# Used ONLY for the agent-ready webhook. This is the UTM host-only IP,
# NOT your Wi-Fi IP, NOT localhost.
# Run `ip route show` inside the KASM VM — the gateway is your Mac's UTM IP.
TEAMBOTS_WEBHOOK_BASE=http://192.168.64.1:4000

# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TEAMBOTS_SECRET=2214fe3597bdaf80af760223c2d4962ae822848c2bd3236c5f952848f5a97ade

# ─── Session Tuning ───────────────────────────────────────────────────────────
KASM_SESSION_READY_TIMEOUT_S=180
KASM_KEEPALIVE_INTERVAL_S=60
